# DB·AI·카카오·소셜 로그인 설정. 값을 채우고 서버를 다시 시작한다 (.env 는 git 에 올리지 않는다)
# jar 가 있는 폴더(IDE 로 띄우면 프로젝트 루트)에 둔다. 없으면 서버가 시작할 때 그곳에 이 빈 틀을 만들어 준다

# 카카오 개발자 > 앱 키
KAKAO_REST_KEY=
KAKAO_JAVASCRIPT_KEY=
KAKAO_NATIVE_KEY=
# 카카오 로그인 > 보안 > Client Secret 을 켰을 때만 (안 켰으면 비워 둔다)
KAKAO_CLIENT_SECRET=

# 구글 클라우드 콘솔 > OAuth 클라이언트 ID (웹 애플리케이션)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 네이버 개발자센터 > 애플리케이션 (네이버 로그인)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 소셜 로그인 후 돌아올 주소의 앞부분. 보통은 비워 둔다:
# 비어 있으면 접속한 주소를 쓰고, localhost 가 아닌 실제 도메인이면 자동으로 https 로 맞춘다.
# 주소가 이상하게 만들어질 때만(예: 다른 도메인·포트로 돌아와야 할 때) 직접 넣는다
# 예: SOCIAL_REDIRECT_BASE=https://reviewro.mrpark.pro
SOCIAL_REDIRECT_BASE=

# DB 접속 (MariaDB). 비어 있으면 서버가 뜨지 않는다
# 예: DB_URL=jdbc:mariadb://호스트:포트/reviewrodb?createDatabaseIfNotExist=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# AI (Ollama). 비어 있으면 서버가 뜨지 않는다
# 예: OLLAMA_ENDPOINT=http://호스트:11434/api
OLLAMA_ENDPOINT=
OLLAMA_MODEL=

# Claude API 키 (https://console.anthropic.com 에서 발급). 비워 두면 Ollama 만 쓴다.
# 넣고 서버를 다시 켜면 슈퍼어드민이 관리자메뉴 > AI 설정에서 Claude 로 바꿀 수 있다
ANTHROPIC_API_KEY=

# https 로만 접속받는 서버는 true (세션 쿠키가 https 로만 오간다). http 로 띄우는 로컬은 비워 둔다
SESSION_COOKIE_SECURE=
